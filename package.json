{
	"name": "polire",
	"private": true,
	"version": "0.2.0",
	"description": "Desktop writing assistant for clearer writing, translation, and quick notes.",
	"author": {
		"name": "Joao V Gugel",
		"email": "gugel@gugelabs.com"
	},
	"homepage": "https://github.com/joao-gugel/polire",
	"license": "MIT",
	"type": "module",
	"main": "dist-electron/main.js",
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"dev:electron": "vite",
		"build:electron": "tsc -b && vite build",
		"package:linux": "bun run build && electron-builder --linux AppImage deb --x64 --publish never",
		"package:win": "bun run build && electron-builder --win nsis --x64 --publish never",
		"package:linux:flatpak": "bun run build && electron-builder --linux flatpak --x64 --publish never",
		"preview": "vite preview",
		"format": "bunx --bun @biomejs/biome check --write .",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"test:coverage": "bun test --coverage",
		"prepare": "husky"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^3.0.79",
		"@ai-sdk/deepseek": "^2.0.35",
		"@ai-sdk/google": "^3.0.79",
		"@ai-sdk/openai": "^3.0.65",
		"@fontsource-variable/geist": "^5.2.9",
		"@phosphor-icons/react": "^2.1.10",
		"ai": "^6.0.191",
		"date-fns": "^4.3.0",
		"electron-updater": "^6.8.3",
		"motion": "^12.40.0",
		"next": "^16.2.6",
		"react": "^19.2.6",
		"react-dom": "^19.2.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@happy-dom/global-registrator": "^20.9.0",
		"@tailwindcss/vite": "^4.0.0",
		"@tailwindcss/postcss": "^4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^4.3.4",
		"electron": "^42.2.0",
		"electron-builder": "26.8.1",
		"husky": "^9.1.7",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.6.3",
		"vite": "^6.0.1",
		"vite-plugin-electron": "^0.29.0",
		"vite-plugin-electron-renderer": "^0.14.6"
	}
}
