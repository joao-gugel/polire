{
	"compilerOptions": {
		"composite": true,
		"tsBuildInfoFile": "./node_modules/.cache/tsc/tsconfig.node.tsbuildinfo",
		"outDir": "./node_modules/.cache/tsc/node",
		"target": "ES2022",
		"lib": ["ES2023"],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"strict": true
	},
	"include": ["vite.config.ts"]
}
